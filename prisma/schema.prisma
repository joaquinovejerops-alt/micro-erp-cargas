// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          String   @default("operador")
  creadoEn     DateTime @default(now()) @map("creado_en")
  historial   HistorialCambio[]
  movimientos   Movimiento[]
  docOkDe            Booking[] @relation("DocOkPor")
  zarpadoDe          Booking[] @relation("ZarpadoPor")
  declaracionDe      Booking[] @relation("DeclaracionPor")
  vgmDe              Booking[] @relation("VgmPor")

  @@map("usuarios")
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  creadoEn  DateTime  @default(now()) @map("creado_en")
  bookings  Booking[]

  @@map("clientes")
}

model Naviera {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  bookings  Booking[]
  regla     ReglaNaviera?

  @@map("navieras")
}

model Booking {
  id                 Int          @id @default(autoincrement())
  bkgNumber          String       @unique @map("bkg_number")
  clienteId          Int          @map("cliente_id")
  navieraId          Int          @map("naviera_id")
  buqueViaje         String?      @map("buque_viaje")
  pol                String?
  pod                String?
  producto           String?
  subcliente         String?
  eta                DateTime?
  cutoffDoc          DateTime?    @map("cutoff_doc")
  cutoffFisico       DateTime?    @map("cutoff_fisico")
  documentacionOk    Boolean   @default(false) @map("documentacion_ok")
  documentacionOkPor Int?      @map("documentacion_ok_por")
  documentacionOkEn  DateTime? @map("documentacion_ok_en")
  zarpadoPor         Int?      @map("zarpado_por")
  zarpadoEn          DateTime? @map("zarpado_en")
  declaracionPor     Int?      @map("declaracion_por")
  declaracionEn      DateTime? @map("declaracion_en")
  vgmPor             Int?      @map("vgm_por")
  vgmEn              DateTime? @map("vgm_en")
  estadoDeclaracion  String       @default("FALTA") @map("estado_declaracion")
  estadoVgm          String       @default("FALTA") @map("estado_vgm")
  creadoEn           DateTime     @default(now()) @map("creado_en")
  actualizadoEn      DateTime     @updatedAt @map("actualizado_en")

  cliente            Cliente      @relation(fields: [clienteId], references: [id])
  naviera            Naviera      @relation(fields: [navieraId], references: [id])
  usuarioDocOk       Usuario? @relation("DocOkPor", fields: [documentacionOkPor], references: [id])
  usuarioZarpado     Usuario? @relation("ZarpadoPor", fields: [zarpadoPor], references: [id])
  usuarioDeclaracion Usuario? @relation("DeclaracionPor", fields: [declaracionPor], references: [id])
  usuarioVgm         Usuario? @relation("VgmPor", fields: [vgmPor], references: [id])
  contenedores       Contenedor[]
  historial     HistorialCambio[]
  movimientos   Movimiento[]

  @@map("bookings")
}

model Contenedor {
  id         Int     @id @default(autoincrement())
  bookingId  Int     @map("booking_id")
  tipo       String
  cantidad   Int

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("contenedores")
}

model HistorialCambio {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cambios   Json
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  creadoEn  DateTime @default(now())

  @@map("historial_cambios")
}

model Movimiento {
  id            Int       @id @default(autoincrement())
  bookingId     Int       @map("booking_id")
  tipo          String    // "INGRESO" | "EGRESO"
  categoria     String?   // EGRESO: "LOCAL" | "FLETE" | "EXTRA"; null si INGRESO
  proveedor     String?   // quién emitió la factura
  descripcion   String    // detalle tal cual la naviera: "THC", "flete neto"...
  montoOriginal Float     @map("monto_original")
  moneda        String    @default("USD") // "USD" | "ARS"
  tipoCambio    Float?    @map("tipo_cambio") // TC del día; null si ya es USD
  montoUsd      Float     @map("monto_usd") // congelado al momento de cargar
  usuarioId     Int       @map("usuario_id")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])

  @@map("movimientos")
}

model ReglaNaviera {
  id            Int             @id @default(autoincrement())
  navieraId     Int?            @unique @map("naviera_id") // link opcional al catálogo Naviera
  codigo        String          @unique // "MAERSK", "CMA_CGM", "PIL"...
  nombre        String          // nombre legible de la naviera
  emisores      Json            @default("[]") // textos para identificar la factura (array)
  limpiezaRegex Json            @default("[]") @map("limpieza_regex") // [{patron, flags}]
  promptExtra   String?         @map("prompt_extra") // instrucción extra para la IA (opcional)
  notas         String?         // reglas especiales en texto
  version       Int             @default(1)
  activo        Boolean         @default(true)
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  naviera       Naviera?        @relation(fields: [navieraId], references: [id])
  conceptos     ReglaConcepto[]

  @@map("reglas_navieras")
}

model ReglaConcepto {
  id             Int          @id @default(autoincrement())
  reglaNavieraId Int          @map("regla_naviera_id")
  patron         String       // el concepto ya limpio, ej "OCEAN FREIGHT"
  categoria      String       // "LOCAL" | "FLETE" | "EXTRA"
  moneda         String       @default("USD")
  tipoMatch      String       @default("includes") @map("tipo_match") // "includes" | "exact" | "regex"
  origen         String       @default("SEMILLA") // "SEMILLA" | "APRENDIDO"
  notas          String?
  creadoEn       DateTime     @default(now()) @map("creado_en")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")

  reglaNaviera   ReglaNaviera @relation(fields: [reglaNavieraId], references: [id], onDelete: Cascade)

  @@unique([reglaNavieraId, patron]) // no repetir el mismo concepto en una naviera
  @@map("reglas_conceptos")
}